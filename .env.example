# HTTP server port (default: 3000)
PORT=3000

# Comma-separated list of valid API keys.
# Leave empty to run without auth (local dev only).
# Generate a key: node -e "console.log('ey_live_' + require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=ey_live_your_key_here

# Set to "stdio" to run as a local Claude Desktop MCP server
# MODE=stdio
