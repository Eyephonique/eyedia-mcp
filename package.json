{
  "name": "eyedia-mcp",
  "version": "1.0.0",
  "description": "MCP server for website AI-readiness checks (ARD, llms.txt, Schema.org)",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:stdio": "tsx src/index.ts --stdio",
    "start:http": "MODE=http tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
